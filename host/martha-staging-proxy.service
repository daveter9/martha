[Unit]
Description=Martha: forward LAN port 8124 to staging Home Assistant
After=network-online.target docker.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/martha/staging_proxy.py
Restart=always
# No privileges needed: a plain TCP forward to 172.30.53.10:8123.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
MemoryMax=64M

[Install]
WantedBy=multi-user.target
